{
  "name": "caseforge",
  "productName": "CaseForge",
  "version": "0.1.0",
  "description": "Gestion de cabinet d'avocats canadiens en vue stratégique isométrique — 100 % locale.",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && electron-builder",
    "test:e2e": "npm run build && npm run rebuild:native && (xvfb-run -a node e2e/electron.e2e.cjs || node e2e/electron.e2e.cjs); status=$?; npm run rebuild:node; exit $status",
    "demo:capture": "node e2e/demo-capture.cjs",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "build": {
    "appId": "ca.caseforge.desktop",
    "productName": "CaseForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": null
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "10.7",
    "@react-three/fiber": "9.8",
    "@react-three/postprocessing": "^3.1.3",
    "better-sqlite3": "^12.11.1",
    "i18next": "^26.4.2",
    "postprocessing": "^6.39.5",
    "react": "19.2",
    "react-dom": "19.2",
    "react-i18next": "^17.0.15",
    "three": "^0.181.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
